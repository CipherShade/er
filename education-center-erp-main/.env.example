# Server
PORT=3000
NODE_ENV=development
DEFAULT_LOCALE=ar

# PostgreSQL
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/edu_center_erp?schema=public"

# Authentication: use long random values in every deployed environment
JWT_SECRET="replace-with-a-random-32-character-secret"
JWT_EXPIRES_IN="12h"
COOKIE_SECRET="replace-with-a-random-cookie-signing-secret"
CORS_ORIGIN="http://localhost:5173"

# Security hardening (optional; sensible defaults shown)
# Comma-separated list of allowed origins for CORS and CSRF
# CORS_ORIGIN may contain multiple origins: "http://localhost:5173,https://app.example.com"
REQUEST_BODY_LIMIT_KB="64"
SOCKET_MAX_PAYLOAD_KB="64"
RATE_LIMIT_LOGIN_WINDOW_MS="60000"
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_CHECKIN_WINDOW_MS="60000"
RATE_LIMIT_CHECKIN_MAX="240"
RATE_LIMIT_SEARCH_WINDOW_MS="60000"
RATE_LIMIT_SEARCH_MAX="240"
RATE_LIMIT_FINANCIAL_WINDOW_MS="60000"
RATE_LIMIT_FINANCIAL_MAX="60"

# Required when running the seed in production
SEED_ADMIN_PASSWORD="replace-before-production-seeding"
SEED_RECEPTIONIST_PASSWORD="replace-before-production-seeding"

# ---------------------------------------------------------------------------
# Frontend endpoint configuration (build-time, baked in by Vite)
# ---------------------------------------------------------------------------
# Single-service deployment (default): Fastify serves the built frontend from
# the same origin, so the API (/api) and Socket.io (/socket.io) use relative
# URLs and these variables stay UNSET.
#
# Split hosting (frontend and API on different hosts): set the absolute URLs
# BEFORE building the frontend, e.g. in the hosting build step:
#   VITE_API_BASE_URL="https://your-api-host.example.com"
#   VITE_SOCKET_URL="https://your-api-host.example.com"   # defaults to VITE_API_BASE_URL
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=""
# VITE_SOCKET_URL=""
